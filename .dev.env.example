# Local development environment for scripts/*.sh and the Tiltfile.
# Copy to .dev.env (gitignored). scripts/cluster.sh does this for you if it's missing.

# kind cluster name (kubectl context becomes kind-ehds-relay)
CLUSTER_NAME=ehds-relay

# Namespace the Helm release is installed into
NAMESPACE=ehds-relay

# Helm release name
RELEASE_NAME=ehds-relay-dev

# Name of the API's session cookie. Cookies on localhost ignore the port, so give each checkout
# that runs side by side its own name (in backend/.env).
# RELAY_SESSION_COOKIE_NAME=relay_session
