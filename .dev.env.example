# Local development environment for scripts/*.sh and the Tiltfile.
# Copy to .dev.env (gitignored). scripts/cluster.sh does this for you if it's missing.

# kind cluster name (kubectl context becomes kind-ehds-relay)
CLUSTER_NAME=ehds-relay

# Namespace the Helm release is installed into
NAMESPACE=ehds-relay

# Helm release name
RELEASE_NAME=ehds-relay-dev

# Name of the API's session cookie. Cookies on localhost ignore the port, so give each checkout
# that runs side by side its own name (in backend/.env).
# RELAY_SESSION_COOKIE_NAME=relay_session

# Local ports used by Tilt's port-forwards and the web dev server. The defaults are shown;
# uncomment and change them to run several checkouts side by side. Keycloak's issuer and
# redirect URLs follow WEB_PORT, API_LOCAL_PORT and KEYCLOAK_LOCAL_PORT automatically.
# API_LOCAL_PORT=8000
# POSTGRES_LOCAL_PORT=5432
# KEYCLOAK_LOCAL_PORT=8080
# MAILPIT_UI_LOCAL_PORT=8025
# MAILPIT_SMTP_LOCAL_PORT=1025
# WEB_PORT=5173

# Settings for running the API or worker on the host (make run, python -m relay.worker)
# against the Tilt port-forwards. Put them in backend/.env; inside the cluster the chart
# sets them. The defaults are shown (the client secret has no default).
# RELAY_OIDC_ISSUER_URL=http://localhost:8080/realms/ehds-relay
# RELAY_OIDC_CLIENT_ID=ehds-relay-bff
# RELAY_OIDC_CLIENT_SECRET=ehds-relay-dev-secret
# RELAY_SMTP_HOST=localhost
# RELAY_SMTP_PORT=1025
