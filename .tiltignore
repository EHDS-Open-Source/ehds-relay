# Tilt ignore patterns - files that shouldn't trigger rebuilds

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Frontend
frontend/node_modules/
frontend/**/node_modules/
frontend/**/dist/

# Testing and coverage
.coverage
htmlcov/
backend/tests/

# Documentation
*.md
docs/

# Logs and temp files
logs/
*.log
.tmp/
*.tmp

# Credentials and secrets
.credentials.env
.env.local
*.key
*.pem

# Kind
.kind/
